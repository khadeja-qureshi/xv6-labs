#include "kernel/types.h"
#include "kernel/user.h"

int main(void){
int p1[2];
int p2[2];
char buf[1];

pipe(p1);
pipe(p2);

int pid = fork();
if(pid < 0){
printf(2,"fork failed");
exit(1);
}

if(pid == 0){
close(p1[1]);
close(p2[0]);

for(int i=0;i<10;i++){
read(p1[0],buf,1);
printf("Child: recieve ping %d",i+1);
write(p2[1],"x" ,1);
}

close(p1[0]);
close(p2[1]);
exit(0);
}

else {
close(p1[0]);
close(p2[1]);

for(int i=0;i<10;i++){
write(p1[1), "x",1);
read(p2[0],buf,1);
printf("parent: pong recieved %d",i+1);

close(p1[0]);
close(p2[1]);
wait(0);
}

exit(0);
}




